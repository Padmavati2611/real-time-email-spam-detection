# ==============================================================================
# REAL-TIME EMAIL SPAM DETECTION ENVIRONMENT VARIABLES
# ==============================================================================

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://username:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="realtime_spam_detection"

# Google OAuth 2.0 Credentials (Downloaded from Google Cloud Console)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8501"

# Google Cloud Pub/Sub Configuration (Optional for Cloud Webhooks)
GCP_PROJECT_ID="your-gcp-project-id"
PUBSUB_TOPIC_NAME="projects/your-project/topics/gmail-notifications"
PUBSUB_SUBSCRIPTION_NAME="projects/your-project/subscriptions/gmail-sub"

# App & Monitoring Settings
POLLING_INTERVAL_SECONDS=30
SAVE_EMAIL_BODY_CONTENT="false"  # Store only metadata and snippets by default for privacy
